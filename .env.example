# Copiar a .env y ajustar. El .env NO se incluye en la imagen (ver .dockerignore).

# Postgres EXTERNO (obligatorio)
DATABASE_URL=postgresql://usuario:password@192.168.1.100:5432/evaluaciones

# Puerto expuesto de la API en el host (opcional, default 8000)
API_PORT=8000

# STORAGE_PATH interno del contenedor: dejar /data (el compose lo monta como volumen).
# STORAGE_PATH=/data
